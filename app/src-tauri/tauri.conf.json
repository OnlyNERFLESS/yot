{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YOT",
  "version": "1.0.8",
  "identifier": "pro.nerfless.toolbox",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Waymate",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "DigiDev",
    "copyright": "© 2026 DigiDev",
    "shortDescription": "YOT: Your Own Tasks",
    "longDescription": "Offline Tehran and Iran maps, metro journey planner, reminders and tasks for field agents.",
    "category": "Productivity",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Farsi"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}