# Copy to .env.local (never committed). Read at build time by app/src-tauri/build.rs
# and compiled into the app as its built-in keys. A key entered on the device wins.
NESHAN_SERVICE_KEY=
NESHAN_WEB_KEY=
# Optional: Google imagery and routes outside Iran (satellite works without it).
GOOGLE_KEY=
# Optional: street view photos (free client token from mapillary.com/dashboard/developers).
MAPILLARY_TOKEN=
